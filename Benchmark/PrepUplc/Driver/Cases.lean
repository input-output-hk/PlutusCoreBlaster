def scriptExtensions : List String := ["uplc", "flat", "cbor", "hex"]

/-- Script files of the repository that `repoScripts` does not list. Hidden directories (among
    them `.lake` and the `.plutus-conformance` symlink) and benchmark outputs are skipped. -/
def unlistedScriptFiles : IO (Array String) := do
  let listed := repoScripts.filterMap (λ s => match s.source with
    | .file path _ _ => some path
    | .const .. => none)
  let skipped := [generatedDir.toString, (("Benchmark" : FilePath) / "results").toString]
  let root : FilePath := "."
  let enter (p : FilePath) : IO Bool := pure <|
    p == root || !((p.fileName.getD "").startsWith "." || skipped.any (p.toString.drop 2 == ·))
  let files ← root.walkDir enter
  let files := files.filterMap (λ (p : FilePath) =>
    let rel := p.toString.drop 2
    if scriptExtensions.any (p.extension == some ·) && !(rel.splitOn "/").any (·.startsWith ".")
        && !skipped.any (rel.startsWith ·) && !listed.contains rel then some rel else none)
  return files.qsort (· < ·)

def importsOf : Source → Array Name
  | .file .. => #[harnessModule]
  | .const module _ => #[harnessModule, module]

def benchCommand (id : String) (source : Source) (conv? : Option Name) (maxSteps : Nat) : String :=
  let conv := match conv? with
    | some f => s!" {f}"
    | none => ""
  match source with
  | .file path lang format => s!"#bench_prep_uplc_file {id.quote} {lang} {format} {path.quote}{conv} {maxSteps}"
  | .const _ name => s!"#bench_prep_uplc {id.quote} {name}{conv} {maxSteps}"

/-- A definition of `args` as the arguments of a concrete call, named `benchArgs`. -/
def argsDefinition (args : List Int) : String :=
  let terms := ", ".intercalate (args.map (λ i => s!".Const (.Integer ({i}))"))
  s!"def benchArgs : List PlutusCore.UPLC.Term.Term := [{terms}]\n"

/-- A script run on no arguments, then once per concrete call. -/
def scriptCases (maxSteps : Nat) (s : RepoScript) : Array BenchCase :=
  let id      := "repo/" ++ s.name
  let applied := s.applied.toArray.map (λ args =>
    let id := s!"{id}({",".intercalate (args.map toString)})"
    mkCase id .repo (importsOf s.source) (benchCommand id s.source `benchArgs maxSteps) (preamble := argsDefinition args))
  #[mkCase id .repo (importsOf s.source) (benchCommand id s.source none maxSteps)] ++ applied

def repoCases (maxSteps : Nat) (unlisted : Array String) : Array BenchCase :=
  let listed := repoScripts.flatMap (scriptCases maxSteps)
  let extra := unlisted.map (λ path =>
    let id := "repo/unlisted/" ++ path
    mkCase id .repo #[harnessModule] (benchCommand id (.file path "PlutusV3" "auto") none maxSteps))
  listed ++ extra

def symbolicCases (budgets : List Nat) : Array BenchCase :=
  repoScripts.flatMap (λ s => match s.symbolic? with
    | none => #[]
    | some inputs =>
      (budgets ++ s.proofSteps.filter (!budgets.contains ·)).toArray.map (λ steps =>
        let id := s!"symbolic/{s.name}@{steps}"
        mkCase id .symbolic (importsOf s.source |>.push inputsModule) (benchCommand id s.source inputs.conv steps)))

end Benchmark.PrepUplc.Driver
