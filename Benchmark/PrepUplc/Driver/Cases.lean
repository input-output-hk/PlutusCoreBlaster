import Lean.Data.Json

/-!
# Benchmark cases

Every case is one generated Lean file that runs one `#bench_prep_uplc` command
(see `Benchmark/PrepUplc/Harness.lean`). The cases are:

* `conformance`: every program the conformance test suite imports, read from the generated tests
  under `Tests/Conformance/Generated` (so the suite skips exactly what those tests skip);
* `repo`: the other scripts of the repository, listed in `repoScripts`, plus any script file the
  manifest misses (found by `unlistedScriptFiles`);
* `symbolic`: the validators of `repoScripts` applied to free `Data` arguments, once per step budget.
-/

namespace Benchmark.PrepUplc.Driver

open Lean (Name Json)
open System (FilePath)

inductive Suite where
  | conformance
  | repo
  | symbolic
  deriving BEq, Inhabited, Repr

def Suite.all : List Suite := [.conformance, .repo, .symbolic]

def Suite.name : Suite → String
  | .conformance => "conformance"
  | .repo        => "repo"
  | .symbolic    => "symbolic"

def Suite.ofString? (s : String) : Option Suite :=
  Suite.all.find? (·.name == s)

structure BenchCase where
  id       : String
  suite    : Suite
  /-- Grouping key for the report: the id without its last component. -/
  category : String
  /-- How the conformance suite expects the program to end (`success`/`evaluation_failure`). -/
  expected : String := ""
  /-- The generated case file, relative to the repository root. -/
  file     : FilePath
  module   : Name
  imports  : Array Name
  /-- The `#bench_prep_uplc…` command the case file runs. -/
  command  : String
  /-- Definitions the command uses, written before it: the arguments of a concrete call. -/
  preamble : String := ""
  deriving Inhabited

/-- Directory of the generated case files. -/
def generatedDir : FilePath := "Benchmark" / "PrepUplc" / "Generated"

def harnessModule       : Name := `Benchmark.PrepUplc.Harness
def inputsModule        : Name := `Benchmark.PrepUplc.Inputs
def scriptEncodingTests : Name := `PlutusCore.UPLC.ScriptEncoding.Tests

/-! ## Names -/

def containsStr (s pattern : String) : Bool :=
  pattern.isEmpty || (s.splitOn pattern).length > 1

/-- A file-name friendly version of a case id. -/
def slug (id : String) : String :=
  "__".intercalate <| (id.splitOn "/").map (λ part =>
    part.map (λ c => if c.isAlphanum || c == '-' || c == '_' || c == '.' || c == '@' then c else '_'))

/-- A module name component for one component of a case id. -/
private def moduleComponent (part : String) : String :=
  let s := part.map (λ c => if c.isAlphanum then c else '_')
  let s := if s.isEmpty then "X" else s
  let s := s.set 0 (s.get 0).toUpper
  if (s.get 0).isDigit then "N" ++ s else s

def category (id : String) : String :=
  "/".intercalate (id.splitOn "/").dropLast

/-- Builds a case; its file and module are derived from the id. -/
def mkCase (id : String) (suite : Suite) (imports : Array Name) (command : String) (expected := "") (preamble := "") : BenchCase :=
  let parts  := (id.splitOn "/").map moduleComponent
  let module := parts.foldl Name.mkStr `Benchmark.PrepUplc.Generated
  let file   := (parts.foldl (· / ·) generatedDir).addExtension "lean"
  { id, suite, category := category id, expected, file, module, imports, command, preamble }

/-- `c` with `_i` appended to the names of its module and file. -/
def BenchCase.renamed (c : BenchCase) (i : Nat) : BenchCase :=
  { c with module := c.module.appendIndexAfter i
           file   := (FilePath.mk (c.file.toString.dropRight ".lean".length ++ s!"_{i}")).addExtension "lean" }

/-- `c`, renamed `_2`, `_3`, … if its module is in `seen`: one of the first `seen.size + 1`
    renamings is free. -/
def uniqueIn (seen : Std.HashSet Name) (c : BenchCase) : BenchCase :=
  if !seen.contains c.module then c
  else ((List.range (seen.size + 1)).map (c.renamed ·.succ.succ) |>.find? (!seen.contains ·.module)).getD c

/-- Makes the files and modules of `cases` unique, in case two ids map to the same module. -/
def disambiguate (cases : Array BenchCase) : Array BenchCase :=
  Prod.snd (cases.foldl (init := (({} : Std.HashSet Name), #[])) (λ (seen, out) c =>
    let c := uniqueIn seen c
    (seen.insert c.module, out.push c)))

/-! ## Case files -/

def caseFileContent (c : BenchCase) (runs : Nat) : String :=
  let imports := "\n".intercalate (c.imports.toList.map (λ m => s!"import {m}"))
  s!"-- Generated by `lake exe bench_prep_uplc`; rewritten on every run.
{imports}

set_option bench.prepUplc.runs {runs}
{if c.preamble.isEmpty then "" else "\n" ++ c.preamble}
{c.command}
"

/-- Replaces the generated directory with the files of `cases`. -/
def writeCaseFiles (cases : Array BenchCase) (runs : Nat) : IO Unit := do
  if ← generatedDir.isDir then
    IO.FS.removeDirAll generatedDir
  cases.forM (λ c => do
    c.file.parent.forM IO.FS.createDirAll
    IO.FS.writeFile c.file (caseFileContent c runs))

/-! ## Conformance -/

/-- Directory of the generated conformance tests the conformance cases are read from. -/
def conformanceTestsDir : FilePath := "Tests" / "Conformance" / "Generated"

/-- `#import_uplc <name> <lang> <format> "<path>"` → `(name, lang, format, path)`. -/
def parseImportUplc? (line : String) : Option (String × String × String × String) := do
  guard (line.startsWith "#import_uplc ")
  match (line.splitOn " ").filter (· ≠ "") with
  | _ :: name :: lang :: format :: _ =>
    let quoted := (line.splitOn "\"").toArray
    guard (quoted.size ≥ 3)
    return (name, lang, format, quoted[1]!)
  | _ => none

/-- The conformance program a generated conformance test imports, if it imports one: its
    `#import_uplc` that is not the `…_expected` one. Parse-error tests don't import anything. -/
def conformanceProgram? (content : String) : Option (String × String × String) :=
  (content.splitOn "\n").findSome? (λ line => do
    let (name, lang, format, path) ← parseImportUplc? line.trim
    guard !(name.endsWith "_expected")
    return (lang, format, path))

/-- `…/test-cases/uplc/evaluation/<dir>/<file>.uplc` → `<dir>`. -/
def conformanceId (path : String) : String :=
  let marker := "test-cases/uplc/evaluation/"
  let rel :=
    match path.splitOn marker with
    | [_, rest] => rest
    | _ => path
  "/".intercalate (rel.splitOn "/").dropLast

/-- The ledger languages and formats `#import_uplc` accepts. -/
def importLanguages : List String := ["PlutusV1", "PlutusV2", "PlutusV3"]
def importFormats   : List String := ["textual", "flat", "flat_hex", "single_cbor_hex", "double_cbor_hex"]

/-- Why a conformance program's language or format is rejected, if it is. Both go verbatim into the
    case's Lean file, and the generated tests come from a plutus checkout, so only the words
    `#import_uplc` accepts may get there. -/
def unsupportedImport? (lang format : String) : Option String :=
  if !importLanguages.contains lang then some s!"unknown ledger language '{lang}'"
  else if !importFormats.contains format then some s!"unknown format '{format}'"
  else none

/-- The case of a generated conformance test importing the program `path`. -/
def conformanceCase (maxSteps : Nat) (content lang format path : String) : BenchCase :=
  let id       := "conformance/" ++ conformanceId path
  let expected :=
    if containsStr content "programsEvalEquiv" then "success"
    else if containsStr content "programEvalsToError" then "evaluation_failure"
    else ""
  let command  := s!"#bench_prep_uplc_file {id.quote} {lang} {format} {path.quote} {maxSteps}"
  mkCase id .conformance #[harnessModule] command (expected := expected)

/-- The case of a generated conformance test, and the path of its program, if it imports one,
    warning about and skipping a program `unsupportedImport?` rejects. -/
def conformanceCase? (maxSteps : Nat) (file : FilePath) : IO (Option (BenchCase × String)) := do
  let content ← IO.FS.readFile file
  let some (lang, format, path) := conformanceProgram? content | return none
  if let some reason := unsupportedImport? lang format then
    IO.eprintln s!"warning: skipping {file}: {reason}"
    return none
  return some (conformanceCase maxSteps content lang format path, path)

def conformanceCases (maxSteps : Nat) : IO (Array BenchCase) := do
  unless ← conformanceTestsDir.isDir do
    throw <| IO.userError s!"{conformanceTestsDir} not found: run from the repository root"
  let files ← conformanceTestsDir.walkDir
  let files := files.filter (·.extension == some "lean") |>.qsort (·.toString < ·.toString)
  let found ← files.filterMapM (conformanceCase? maxSteps)
  if let some (_, path) := found[0]? then
    unless ← FilePath.pathExists path do
      throw <| IO.userError s!"conformance program {path} not found: the conformance cases need \
        the .plutus-conformance symlink (see `make gen_conformance_tests`), or pass --suite repo,symbolic"
  return found.map (·.1)

/-! ## Repository scripts -/

inductive Source where
  /-- A script file, imported with `#import_uplc <lang> <format>`. -/
  | file (path lang format : String)
  /-- A `Program` or `PlutusScript` constant of `module`. -/
  | const (module : Name) (name : Name)

/-- The free arguments of the symbolic cases of a script. -/
inductive Inputs where
  /-- `count` free `Data` arguments (`dataArgs<count>`). -/
  | data (count : Nat)
  /-- `count` free `Integer` arguments (`integerArgs<count>`). -/
  | integers (count : Nat)

/-- The conversion function of `Inputs.lean` giving these arguments. -/
def Inputs.conv : Inputs → Name
  | .data count     => inputsModule ++ Name.mkSimple s!"dataArgs{count}"
  | .integers count => inputsModule ++ Name.mkSimple s!"integerArgs{count}"

structure RepoScript where
  /-- Case id, without the suite prefix. -/
  name       : String
  source     : Source
  /-- The free arguments of its symbolic cases, if it has any. For a validator, the number of
      `Data` arguments is the least number of `Data.I 0` arguments with which the script no
      longer evaluates to a lambda (see `Benchmark/README.md`). -/
  symbolic?  : Option Inputs := none
  /-- The step budgets of the proof the script comes from: its symbolic cases run at these as
      well as at `--symbolic-steps`. -/
  proofSteps : List Nat := []
  /-- Concrete calls: each list of integer arguments is one more closed case in the repo suite. -/
  applied    : List (List Int) := []

