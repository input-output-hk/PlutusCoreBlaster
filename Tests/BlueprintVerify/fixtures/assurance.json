  "properties": [
    {
      "id": "spend-always-rejects",
      "title": "The placeholder spend handler rejects every transaction",
      "scope": {
        "validators": ["placeholder.placeholder.spend"]
      },
      "statement": {
        "text": "For every script context, executing the compiled spend validator errors (every handler is a `todo`), so no UTxO locked at this script can ever be spent.",
        "formal": {
          "language": "lean",
          "source": "∀ (d : Data), isErrorState (cekExecuteProgram placeholder_placeholder_spend.script [Term.Const (Const.Data d)] 2500)"
        }
      },
      "assumptions": [
        {
          "text": "The CEK execution budget of 2500 steps is sufficient to reach the error."
        }
      ],
      "tags": ["safety"],
      "evidence": [
        {
          "method": "formal-proof",
          "verifier": "PlutusCoreBlaster test suite",
          "tool": "blaster",
