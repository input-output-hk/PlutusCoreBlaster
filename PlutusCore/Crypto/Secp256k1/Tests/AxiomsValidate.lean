/-! ### `verifyEcdsaSecp256k1Signature_isOk`: the ECDSA result domain

    A boolean comes back exactly on a well formed 33-byte key, a 32-byte message and a
    64-byte signature whose scalars are in range.  Everything else fails. -/

#guard (verifyEcdsaSecp256k1Signature ecdsaOkPk    ecdsaOkMsg    ecdsaOkSig   ).toOption == some true
#guard (verifyEcdsaSecp256k1Signature ecdsaHighSPk ecdsaHighSMsg ecdsaHighSSig).toOption == some false

#guard (verifyEcdsaSecp256k1Signature ecdsaOffCurvePk    ecdsaOffCurveMsg    ecdsaOffCurveSig   ).toOption == none
#guard (verifyEcdsaSecp256k1Signature ecdsaBadPrefixPk   ecdsaBadPrefixMsg   ecdsaBadPrefixSig  ).toOption == none
#guard (verifyEcdsaSecp256k1Signature ecdsaROutOfRangePk ecdsaROutOfRangeMsg ecdsaROutOfRangeSig).toOption == none
#guard (verifyEcdsaSecp256k1Signature ecdsaSOutOfRangePk ecdsaSOutOfRangeMsg ecdsaSOutOfRangeSig).toOption == none
#guard (verifyEcdsaSecp256k1Signature ecdsaShortKeyPk    ecdsaShortKeyMsg    ecdsaShortKeySig   ).toOption == none
#guard (verifyEcdsaSecp256k1Signature ecdsaLongKeyPk     ecdsaLongKeyMsg     ecdsaLongKeySig    ).toOption == none
#guard (verifyEcdsaSecp256k1Signature ecdsaShortMsgPk    ecdsaShortMsgMsg    ecdsaShortMsgSig   ).toOption == none
#guard (verifyEcdsaSecp256k1Signature ecdsaLongMsgPk     ecdsaLongMsgMsg     ecdsaLongMsgSig    ).toOption == none
#guard (verifyEcdsaSecp256k1Signature ecdsaShortSigPk    ecdsaShortSigMsg    ecdsaShortSigSig   ).toOption == none
#guard (verifyEcdsaSecp256k1Signature ecdsaLongSigPk     ecdsaLongSigMsg     ecdsaLongSigSig    ).toOption == none

/- `not_validSchnorrPublicKey_of_validEcdsaPublicKey`, on the vectors: an ECDSA key is not a
   Schnorr key, and the other way round, and the builtins say so by failing. -/

#guard (verifySchnorrSecp256k1Signature ecdsaOkPk   ecdsaOkMsg   ecdsaOkSig  ).toOption == none
#guard (verifyEcdsaSecp256k1Signature   schnorrOkPk schnorrOkMsg schnorrOkSig).toOption == none

/-! ### `verifySchnorrSecp256k1Signature_isOk`: the Schnorr result domain

    A boolean comes back exactly on a well formed 32-byte key and a 64-byte signature.  The
    message is not part of the domain: Schnorr hashes it itself, so any size will do. -/

#guard (verifySchnorrSecp256k1Signature schnorrOkPk     schnorrOkMsg     schnorrOkSig    ).toOption == some true
#guard (verifySchnorrSecp256k1Signature schnorrOddYPk   schnorrOddYMsg   schnorrOddYSig  ).toOption == some false
#guard (verifySchnorrSecp256k1Signature schnorrEmptyMsgPk   schnorrEmptyMsgMsg   schnorrEmptyMsgSig  ).toOption == some true
#guard (verifySchnorrSecp256k1Signature schnorrOneByteMsgPk schnorrOneByteMsgMsg schnorrOneByteMsgSig).toOption == some true

#guard (verifySchnorrSecp256k1Signature schnorrOffCurvePk  schnorrOffCurveMsg  schnorrOffCurveSig ).toOption == none
#guard (verifySchnorrSecp256k1Signature schnorrKeyTooBigPk schnorrKeyTooBigMsg schnorrKeyTooBigSig).toOption == none
#guard (verifySchnorrSecp256k1Signature schnorrShortKeyPk  schnorrShortKeyMsg  schnorrShortKeySig ).toOption == none
#guard (verifySchnorrSecp256k1Signature schnorrLongKeyPk   schnorrLongKeyMsg   schnorrLongKeySig  ).toOption == none
#guard (verifySchnorrSecp256k1Signature schnorrShortSigPk  schnorrShortSigMsg  schnorrShortSigSig ).toOption == none
#guard (verifySchnorrSecp256k1Signature schnorrLongSigPk   schnorrLongSigMsg   schnorrLongSigSig  ).toOption == none

/-! ### The axiom set is satisfiable

    A model of `AllSpec`: each verifier accepts exactly on its domain, a key is well formed
    when it has the right size, `ValidEcdsaScalars` is unconstrained beyond its place in
    the domain, and the key holder is taken to have signed the empty message only.  The
    `NoForgery` guards rule out everything else, which is what makes guarded unforgeability
    and guarded message binding hold at once. -/

private def mockEcdsaVerify (pk msg sig : ByteString) : Except String Bool :=
  if pk.length == 33 && msg.length == 32 && sig.length == 64 then .ok true else .error "out of domain"

private def mockSchnorrVerify (pk _msg sig : ByteString) : Except String Bool :=
  if pk.length == 32 && sig.length == 64 then .ok true else .error "out of domain"

private def mockEcdsaKey     (pk : ByteString) : Prop := pk.length = 33
private def mockSchnorrKey   (pk : ByteString) : Prop := pk.length = 32
private def mockEcdsaSigOk   (_sig : ByteString) : Prop := True

private def mockSigned (V : ByteString → ByteString → ByteString → Except String Bool)
    (pk msg sig : ByteString) : Prop :=
  V pk msg sig = .ok true ∧ msg = emptyByteString

private def mockNoForgery (V : ByteString → ByteString → ByteString → Except String Bool)
    (pk msg sig : ByteString) : Prop :=
  V pk msg sig = .ok true → msg = emptyByteString

private theorem mock_domain :
  DomainSpec mockEcdsaVerify mockSchnorrVerify mockEcdsaKey mockEcdsaSigOk mockSchnorrKey := by
  refine ⟨fun _ h => h, fun _ h => h, ?_, ?_⟩
  . intro pk msg sig
    unfold mockEcdsaVerify mockEcdsaKey mockEcdsaSigOk
    cases h33 : pk.length == 33 <;> cases h32 : msg.length == 32 <;> cases h64 : sig.length == 64 <;>
      simp_all [Except.isOk, Except.toBool]
  . intro pk msg sig
    unfold mockSchnorrVerify mockSchnorrKey
    cases h32 : pk.length == 32 <;> cases h64 : sig.length == 64 <;>
      simp_all [Except.isOk, Except.toBool]

private theorem mock_scheme_forgery
  (V : ByteString → ByteString → ByteString → Except String Bool) :
  SchemeForgerySpec V (mockSigned V) (mockNoForgery V) := by
  refine ⟨?_, ?_, ?_⟩
  . intro pk msg sig hs
    exact hs.left
  . intro pk msg sig hn hv
    exact ⟨hv, hn hv⟩
  . intro pk msg msg' sig _ _ hs hs'
    rw [hs.right, hs'.right]

theorem allSpec_satisfiable :
  ∃ (Ve Vs : ByteString → ByteString → ByteString → Except String Bool)
    (Ke Sc Ks : ByteString → Prop)
    (Se Ne Ss Ns : ByteString → ByteString → ByteString → Prop),
      AllSpec Ve Vs Ke Sc Ks Se Ne Ss Ns :=
  ⟨mockEcdsaVerify, mockSchnorrVerify,
   mockEcdsaKey, mockEcdsaSigOk, mockSchnorrKey,
   mockSigned mockEcdsaVerify, mockNoForgery mockEcdsaVerify,
   mockSigned mockSchnorrVerify, mockNoForgery mockSchnorrVerify,
   mock_domain,
   mock_scheme_forgery mockEcdsaVerify, mock_scheme_forgery mockSchnorrVerify⟩

end PlutusCore.Crypto.Secp256k1.Tests.AxiomsValidate
